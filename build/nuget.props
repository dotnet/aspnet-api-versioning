<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

 <PropertyGroup>
  <IsPackable>true</IsPackable>
  <RepositoryType>git</RepositoryType>
  <RepositoryUrl>https://github.com/dotnet/aspnet-api-versioning</RepositoryUrl>
  <PackageIcon>icon.png</PackageIcon>
  <PackageProjectUrl>https://dotnet.github.io/aspnet-api-versioning</PackageProjectUrl>
  <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
  <PackageLicenseExpression>MIT</PackageLicenseExpression>
  <PackageOutputPath Condition=" $(PackageOutputPath) == '' ">$(MSBuildThisFileDirectory)..\bin</PackageOutputPath>
  <!-- the path is relative to the package root, not the file system; the corresponding file is packed in nuget.targets -->
  <PackageReadmeFile Condition="Exists('$(MSBuildProjectDirectory)\README.md')">README.md</PackageReadmeFile>
  <NoWarn>NU5118;$(NoWarn)</NoWarn>
 </PropertyGroup>

 <ItemGroup Label="Package Files">
  <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="" Visible="false" />
  <None Include="$(MSBuildThisFileDirectory)..\LICENSE.txt" Pack="true" PackagePath="" Visible="false" />
 </ItemGroup>

 <!-- allow build-specific, one-time release notes from the command-line without modifying the source project -->
 <ItemGroup>
  <ReleaseNotes Include="$(BuildReleaseNotes.Split('|'))" />
 </ItemGroup>

 <!-- REF: https://github.com/dotnet/sourcelink/blob/master/README.md -->
 <PropertyGroup>
  <PublishRepositoryUrl>true</PublishRepositoryUrl>
  <EmbedUntrackedSources>true</EmbedUntrackedSources>

  <!-- REF: https://github.com/clairernovotny/DeterministicBuilds -->
  <ContinuousIntegrationBuild Condition=" ('$(TF_BUILD)' == 'true') OR ('$(GITHUB_ACTIONS)' == 'true') ">true</ContinuousIntegrationBuild>
 </PropertyGroup>

 <!-- an analyzer runs in the compiler rather than in the consuming application, so there is nothing to debug into from
      its package. it also packs no build output, which leaves a symbol package with nothing to describe and fails to
      pack with NU5017 -->
 <PropertyGroup Label="SourceLink" Condition=" '$(IsAnalyzer)' != 'true' ">
  <IncludeSymbols>true</IncludeSymbols>
  <SymbolPackageFormat>snupkg</SymbolPackageFormat>
 </PropertyGroup>

 <ItemGroup Label="SourceLink" Condition=" '$(IsAnalyzer)' != 'true' ">
  <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.0-*" PrivateAssets="All"/>
 </ItemGroup>

</Project>
