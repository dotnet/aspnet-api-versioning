<Project Sdk="Microsoft.NET.Sdk">

 <PropertyGroup>
  <VersionPrefix>10.2.0</VersionPrefix>
  <AssemblyVersion>10.2.0.0</AssemblyVersion>
  <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
  <RootNamespace>Asp.Versioning</RootNamespace>
  <AssemblyTitle>ASP.NET Core API Versioning API Explorer for gRPC</AssemblyTitle>
  <Description>The API Explorer extensions for ASP.NET Core API Versioning and gRPC.</Description>
  <PackageTags>Asp;AspNet;AspNetCore;Versioning;ApiExplorer;gRPC</PackageTags>
  <IsAotCompatible>true</IsAotCompatible>
 </PropertyGroup>

 <ItemGroup>
  <PackageReference Include="Microsoft.AspNetCore.Grpc.JsonTranscoding" Version="10.0.10" />
 </ItemGroup>

 <ItemGroup>
   <ProjectReference Include="..\Asp.Versioning.Http\Asp.Versioning.Http.csproj" />
 </ItemGroup>

</Project>