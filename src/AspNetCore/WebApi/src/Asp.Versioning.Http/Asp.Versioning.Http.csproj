<Project Sdk="Microsoft.NET.Sdk">

 <PropertyGroup>
  <VersionPrefix>10.2.3</VersionPrefix>
  <AssemblyVersion>10.2.0.0</AssemblyVersion>
  <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
  <RootNamespace>Asp.Versioning</RootNamespace>
  <AssemblyTitle>ASP.NET Core API Versioning</AssemblyTitle>
  <Description>A service API versioning library for Microsoft ASP.NET Core.</Description>
  <PackageTags>Asp;AspNet;AspNetCore;Versioning</PackageTags>
  <IsAotCompatible>true</IsAotCompatible>
 </PropertyGroup>

 <ItemGroup>
  <FrameworkReference Include="Microsoft.AspNetCore.App" />
 </ItemGroup>

 <!-- guidance for coding agents, packed by the build-only Trellis.AgentDocs.Packaging helper; adds no runtime dependency -->
 <ItemGroup Label="AgentDocs">
  <PackageReference Include="Trellis.AgentDocs.Packaging" Version="0.1.0-preview.22" PrivateAssets="all" />
  <PackageGuidanceItem Include="docs/agent-guide.md"
                       PackagePath="guides/agent-guide.md"
                       Usage="required"
                       Description="Read before adding or changing API versioning with Asp.Versioning.Http (Minimal APIs): registration, versioning endpoints, and default behavior." />
  <PackageGuidanceItem Include="docs/version-sources-and-defaults.md"
                       PackagePath="guides/version-sources-and-defaults.md"
                       Description="Open when changing how clients send the API version (query string, header, URL segment) or what happens when none is sent." />
  <PackageGuidanceItem Include="docs/deprecation-and-errors.md"
                       PackagePath="guides/deprecation-and-errors.md"
                       Description="Open when deprecating an API version, reading version headers, or changing unspecified, unsupported or invalid version responses." />
 </ItemGroup>

 <ItemGroup>
  <InternalsVisibleTo Include="Asp.Versioning.Mvc" Key="$(StrongNamePublicKey)" />
 </ItemGroup>

 <ItemGroup>
  <ProjectReference Include="..\..\..\..\Abstractions\src\Asp.Versioning.Abstractions\Asp.Versioning.Abstractions.csproj" />
 </ItemGroup>

 <!-- the analyzer ships inside this package so that it reaches this package and everything built on
      it. it is not a ProjectReference because the analyzer is not packable, which would otherwise
      pack its assembly into lib rather than as an analyzer -->
 <ItemGroup>
  <AnalyzerProjectReference Include="..\..\..\..\Analyzers\src\Asp.Versioning.Api.Analyzers\Asp.Versioning.Api.Analyzers.csproj" />
 </ItemGroup>

 <Import Project="..\..\..\..\Common\src\Common\Common.projitems" Label="Shared" />
 <Import Project="..\..\..\..\Common\src\Common.ProblemDetails\Common.ProblemDetails.projitems" Label="Shared" />

</Project>